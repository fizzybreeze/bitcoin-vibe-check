# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
#
# Note: VITE_-prefixed variables are compiled into the client bundle by design
# and are readable by anyone who opens devtools on the deployed site. Only ever
# put publishable/anon keys here — never a service-role key or a private secret.

# NOTE: VITE_COINGECKO_API_KEY is deliberately absent. CoinGecko was replaced by
# CoinPaprika (market data) and Kraken (charts); no code reads that key any
# more. If it is still set in Vercel it can be deleted. Every remaining data
# source is keyless except BGeometrics below.

# Supabase project URL and anon key, used for donor name submissions and for the
# Vibe Score history sparkline's read of metric_snapshots.
# Optional: src/lib/supabase.js returns null when these are absent, so the app
# still runs — but the donation card stops working and the sparkline never
# appears (which is also how it looks before 7 days of history exist, so the
# console warning below is the signal, not the card). Leaving one of them blank
# is the same as leaving it out: the client is not built, and a console warning
# at startup names the one that is missing.
# https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# VAPID public key for Web Push, read by src/lib/vapid.js. Public by
# definition — it is handed to the push service by every subscribing browser,
# so the VITE_ prefix is correct here rather than merely tolerated.
# Generate the pair with:  npx web-push generate-vapid-keys
# and put the *private* half in VAPID_PRIVATE_KEY below, never here.
# Optional: absent or blank means the push toggle reports itself unavailable
# and the panel falls back to saying alerts only fire while the tab is open.
# Blank counts as absent — a key saved empty in Vercel is not configured.
VITE_VAPID_PUBLIC_KEY=

# ── Server-side only (no VITE_ prefix; never reaches the browser) ─────────────

# VAPID private key, the other half of the pair above. Read by
# api/push-evaluate.js to sign every push it sends. Keep it in Vercel's
# environment; it is the credential that proves a push came from this site, so
# anyone holding it can notify every subscriber. Absent means the sender
# answers 503 and refuses to run, which is deliberate — see below.
VAPID_PRIVATE_KEY=

# The bearer token pg_cron presents to api/push-evaluate.js, and the only thing
# between an anonymous POST and a notification to every subscriber. Any long
# random string: `openssl rand -hex 32`.
#
# It has to be set in TWO places and they must match: here (Vercel) and in the
# Supabase Vault, which is where the cron job reads it from —
#   select vault.create_secret('<this value>', 'push_evaluate_secret', '');
# See supabase/migrations/20260809120000_schedule_push_evaluate.sql. A mismatch
# shows up as a column of 401s in push_evaluate_log, not as silence.
PUSH_EVALUATE_SECRET=

# Service-role key, read by api/push-evaluate.js alone. It is the only way to
# read push_subscriptions: that table has no SELECT policy and must never get
# one, because an endpoint readable with the anon key is an enumeration oracle
# for every subscriber's browser. NEVER put this in a VITE_ variable — it would
# ship to every visitor and it bypasses RLS on every table.
SUPABASE_SERVICE_ROLE_KEY=

# BGeometrics API key, read by the api/chain-data.js serverless function for
# MVRV data. Set in Vercel project settings, not here, for deployed builds.
# Free tier is 15 requests/day, which is why that route caches for 24h.
BGEOMETRICS_API_KEY=

# ── GitHub Actions secrets, not local .env ───────────────────────────────────
#
# Listed here so this file is a complete inventory rather than a partial one,
# but these belong in the repository's Actions secrets, not in a local .env —
# nothing in `npm run dev` reads them.
#
#   SUPABASE_SERVICE_ROLE_KEY   the snapshot job's write credential (above)
#   NOSTR_PRIVATE_KEY           nsec1… or 64 hex. **Its presence is the on/off
#                               switch for the daily Nostr post**: absent or
#                               blank means compose, print, publish nothing.
#   NOSTR_RELAYS                optional, comma-separated, overrides the four
#                               default relays.
#
# See scripts/SNAPSHOT_SETUP.md.

# Optional. api/chain-data.js reads these when BGeometrics does not answer, to
# serve the last MVRV the snapshot job stored in metric_snapshots. It falls back
# to the VITE_ pair above — same project, same key — so setting these is only
# needed if the function should use different credentials. Anon, never
# service-role: metric_snapshots grants SELECT to public, so the fallback needs
# no privilege the client bundle does not already carry. Absent means no
# fallback, not a broken route.
SUPABASE_URL=
SUPABASE_ANON_KEY=
